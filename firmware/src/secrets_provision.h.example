#pragma once
// このファイルを secrets_provision.h にコピーして値を埋める…のではなく、
// 通常は tools/provision_device.py provision-h --id N が devices.json から
// 自動生成する。secrets_provision.h は gitignore 対象。
//
// [env:provision]/[env:adxl355-provision] だけがこれを読み、NVSへ書いて終わる
// （通常のfirmwareはNVSから読む。docs/ota.md §7）。

#include <cstdint>

static constexpr uint32_t kProvDeviceId = 1;

static constexpr const char* kProvWifiSsid = "your-ssid";
static constexpr const char* kProvWifiPass = "your-pass";

// HMAC-SHA256 共有鍵（ingest側の device_id->secret と一致させる）
static constexpr const char* kProvHmacSecret = "change-me-32bytes-random-secret";
// ArduinoOTA(espota、LAN内push)認証パスワード。サーバ側とは無関係のLAN内専用鍵。
static constexpr const char* kProvOtaPassword = "change-me-ota-password";

// ingest Lambda の Function URL（30秒バッチのPOST先）
static constexpr const char* kProvIngestUrl = "https://xxxxx.lambda-url.ap-northeast-1.on.aws/";
// alert Lambda の Function URL（デバイス速報のPOST先）。ingestと同じでもよい。
static constexpr const char* kProvAlertUrl = "https://xxxxx.lambda-url.ap-northeast-1.on.aws/alert";
// api Lambda の Function URL（pull型OTAの更新確認・ダッシュボード読み取り用）
static constexpr const char* kProvApiUrl = "https://xxxxx.lambda-url.ap-northeast-1.on.aws";
// OTAバイナリ配布元（ダッシュボードと共通のCloudFront。docs/ota.md §7）
static constexpr const char* kProvOtaBaseUrl = "https://xxxxx.cloudfront.net";
